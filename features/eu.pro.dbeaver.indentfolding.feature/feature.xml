<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="eu.pro.dbeaver.indentfolding.feature"
      label="%featureName"
      version="1.2.0.qualifier"
      provider-name="%providerName">

   <description>%description</description>

   <copyright>%copyright</copyright>

   <license url="https://www.apache.org/licenses/LICENSE-2.0">
      Apache License, Version 2.0
   </license>

   <requires>
      <!--
         This feature is intentionally a selector, not an implementation container.
         Eclipse p2 chooses the newest eu.pro.dbeaver.indentfolding bundle whose
         OSGi Require-Bundle constraints are satisfiable by the installed DBeaver.
      -->
      <import
            plugin="eu.pro.dbeaver.indentfolding"
            version="1.0.0"
            match="greaterOrEqual"/>
   </requires>
</feature>
